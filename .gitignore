# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.venv-host/
.pytest_cache/
.ruff_cache/
.ty_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# direnv (committed .envrc picks the per-layer uv venv; .direnv/ cache is local)
.direnv/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Rdata

# Rendered R Markdown outputs (source-only convention)
analysis/*.html
analysis/*_files/
analysis/*_cache/

# Models
model/

# Patient video data (never commit): the videos/ session tree, plus any
# stray clip anywhere in the tree (e.g. dropped in the project root). Globs
# are case-folded so .MP4 / .mp4 / .Mov etc. all match.
videos
*.[mM][pP]4
*.[mM][oO][vV]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[mM]4[vV]
*.[wW][mM][vV]
*.[wW][eE][bB][mM]

# Pose estimation output (never commit)
output
benchmark_output

# Corpus registry (patient-adjacent: carries source paths — never commit).
# census.json inside it holds aggregates only and is safe to quote.
# Slash-free on purpose: a trailing slash matches a directory and NOT a symlink
# of the same name, and worktree briefs hand teammates exactly such a symlink.
# `inventory` matches a whole path component, so `inventory.py` stays tracked.
inventory

# Measurement sidecar (patient-adjacent: one row per corpus asset pair, keyed
# by the registry's ids). Re-derived by `measure`; the manifest digests the
# registry, so a committed copy could never be re-derived from the repo alone.
# Aggregates over it (acceptance counts, closure medians) are safe to quote.
measurements/

# Materialized session tree (patient-adjacent: symlink targets and manifests
# carry source paths). The second pattern covers the sibling staging and
# retiring directories publication renames through. `sessions` is slash-free so
# it also catches a symlink of that name; it matches a whole path component, so
# src/pose_estimation/sessions.py and docs/technical/sessions.md stay tracked,
# which an unsuffixed `sessions.*` would not.
sessions
sessions.*/

# Qualification evidence set (patient-adjacent: per-asset rows keyed by
# capture_id pseudonyms). qualification.json inside it holds aggregates only
# and is safe to quote. Same two-pattern shape as sessions, for the same
# staging/retiring siblings and the same collision with the module and doc.
qualification/
qualification.*/

# Camera calibration (patient-adjacent: identifying lab/rig geometry — never commit)
calibration/
calibration.json

# Secrets / credentials (safety net)
.env
.env.*
*.env

# OS
.DS_Store
Thumbs.db

# Posit
.positai/

# Logs (may capture session/patient paths)
*.log

# MediaPipe downloaded models
mediapipe/

# Claude Code machine-local state (the shared .claude/settings.json is committed);
# .claude/.headroom_wrap_marker.json is ephemeral per-session (pid/port/env key).
CLAUDE.local.md
.claude/settings.local.json
.claude/.headroom_wrap_marker.json
.claude/worktrees/

# Per-session teammate reports, rosters + per-teammate git worktrees
# (.scratch/worktrees/<name>; see .claude/commands/session-roadmap.md)
.scratch/

# Serena self-governs via .serena/.gitignore: cache + project.local.yml local,
# project.yml + .gitignore committed. Memory tools are disabled globally, so
# .serena/memories/ stays empty. Serena's own .gitignore omits logs/, which is
# regenerable and unmatched by the *.log rule above.
.serena/logs/
